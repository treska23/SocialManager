<Window x:Class="SocialManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SocialManager.App.ViewModels"
        mc:Ignorable="d"
        Title="Kid D — Social Manager"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="KD" Foreground="#0E1015" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProjectName}" FontWeight="Black" FontSize="14" />
                        <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="ESPACIO DE TRABAJO" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource MutedTextBrush}" Margin="16,0,0,8" />
                    <Button Content="Inicio" Style="{StaticResource ActiveNavButtonStyle}" Margin="0,2" />
                    <Button Content="Contenido" Style="{StaticResource NavButtonStyle}" Margin="0,2" IsEnabled="False" />
                    <Button Content="Calendario" Style="{StaticResource NavButtonStyle}" Margin="0,2" IsEnabled="False" />
                    <Button Content="Publicaciones" Style="{StaticResource NavButtonStyle}" Margin="0,2" IsEnabled="False" />
                    <Button Content="Comunidad" Style="{StaticResource NavButtonStyle}" Margin="0,2" IsEnabled="False" />
                    <Button Content="Analítica" Style="{StaticResource NavButtonStyle}" Margin="0,2" IsEnabled="False" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Background="#151922" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="MANAGER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding ManagerStatus}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="Configuración" Style="{StaticResource NavButtonStyle}" IsEnabled="False" />
                    <TextBlock Text="SocialManager · UI v0.1" Foreground="#596171" FontSize="10" Margin="16,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#10131A">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Inicio" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Centro de control de Kid D" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentDarkBrush}" BorderBrush="#3B4B13" BorderThickness="1" CornerRadius="20" Padding="12,7" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding ManagerStatus}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Content="+  AÑADIR CONTENIDO" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddContentCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,30,32,36">

                    <!-- Voice manager -->
                    <Border Style="{StaticResource CardStyle}" Padding="28" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="390" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,4,36,4">
                                <TextBlock Text="MANAGER CREATIVO" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Cuéntale qué has creado.&#10;Él se ocupa de cómo moverlo." FontSize="31" FontWeight="Black" LineHeight="38" Margin="0,12,0,12" />
                                <TextBlock Text="{Binding VoiceHint}" Style="{StaticResource MutedTextStyle}" FontSize="14" TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                    <Button Content="{Binding VoiceButtonText}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleVoiceCommand}" Padding="22,13" />
                                    <TextBlock Text="voz → contexto → LLaMA → publicación" Foreground="#626B7B" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#11151D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ENTRADA DEL MANAGER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="86" Height="86" CornerRadius="43" Background="{StaticResource AccentDarkBrush}" BorderBrush="#405214" BorderThickness="1">
                                            <TextBlock Text="●" Foreground="{StaticResource AccentBrush}" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="VOZ" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding ActivityMessage}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- KPI row -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="EN COLA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding QueueCount}" FontSize="30" FontWeight="Black" Margin="0,5,0,0" />
                                <TextBlock Text="contenidos pendientes" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="BORRADORES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding DraftCount}" FontSize="30" FontWeight="Black" Margin="0,5,0,0" />
                                <TextBlock Text="esperando revisión" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PRÓXIMA PUBLICACIÓN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding NextPostTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,3" />
                                    <TextBlock Text="{Binding NextPostTime}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#202630" CornerRadius="8" Padding="10,6" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding NextPostPlatform}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Accounts + planner -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="22">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Redes" FontSize="17" FontWeight="Bold" />
                                    <TextBlock Text="3 plataformas" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Networks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#12161E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{Binding AccentColor}" CornerRadius="3" Margin="0,1,0,1" />
                                                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Handle}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Planificador inteligente" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="El horario no será fijo: irá aprendiendo de Kid D y de cada plataforma." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,18" />
                                <Border Background="#12161E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="SIN DATOS TODAVÍA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="Cuando publiquemos, aquí aparecerán las mejores franjas por TikTok, Instagram y YouTube." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Button Content="ABRIR CALENDARIO" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenPlannerCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Workflow -->
                    <Border Style="{StaticResource CardStyle}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Cómo trabajará el manager" FontSize="17" FontWeight="Bold" Margin="0,0,0,17" />
                            <UniformGrid Columns="4">
                                <Border Background="#12161E" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontWeight="Black" FontSize="12" />
                                        <TextBlock Text="CONTENIDO" FontWeight="Bold" FontSize="11" Margin="0,12,0,5" />
                                        <TextBlock Text="Añades dibujo, música o animación." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#12161E" CornerRadius="10" Padding="16" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="02" Foreground="{StaticResource AccentBrush}" FontWeight="Black" FontSize="12" />
                                        <TextBlock Text="EXPLICACIÓN" FontWeight="Bold" FontSize="11" Margin="0,12,0,5" />
                                        <TextBlock Text="Le cuentas por voz qué significa." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#12161E" CornerRadius="10" Padding="16" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="03" Foreground="{StaticResource AccentBrush}" FontWeight="Black" FontSize="12" />
                                        <TextBlock Text="ESTRATEGIA" FontWeight="Bold" FontSize="11" Margin="0,12,0,5" />
                                        <TextBlock Text="LLaMA adapta texto, hashtags y formato." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#12161E" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="04" Foreground="{StaticResource AccentBrush}" FontWeight="Black" FontSize="12" />
                                        <TextBlock Text="PUBLICACIÓN" FontWeight="Bold" FontSize="11" Margin="0,12,0,5" />
                                        <TextBlock Text="Publica, mide resultados y aprende." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
